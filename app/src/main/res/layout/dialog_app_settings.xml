<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_custom_feedback"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_custom_feedback"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vibration_pattern"
            android:layout_marginTop="16dp" />

        <Spinner
            android:id="@+id/spinnerVibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnRecordVibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/record_custom_vibration"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvVibrationOverlapTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vibration_overlap_tip"
            android:textSize="12sp"
            android:alpha="0.7"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnAppNotificationSettings"
            style="?attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_app_notification_settings"
            android:layout_marginTop="4dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchFlash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/camera_flash"
            android:layout_marginTop="16dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notification_sound"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/schedule_active_window"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_time_schedule"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:id="@+id/layoutScheduleTimes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvStartTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/time_start_default"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_to" />

            <TextView
                android:id="@+id/tvEndTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/time_end_default"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:layout_marginTop="32dp" />

    </LinearLayout>
</ScrollView>
